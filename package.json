{
  "name": "houseofbetterauth",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "nuxt dev",
    "test": "vitest run --silent=false",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "coverage": "vitest run --coverage",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "nuxt typecheck",
    "auth:schema": "pnpm exec auth generate --config server/utils/auth.ts --output server/db/schema/auth.ts --yes",
    "db:generate": "drizzle-kit generate --config ./server/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./server/db/drizzle.config.ts",
    "db:backfill-api-keys": "node scripts/backfill-api-key-organization.ts",
    "build": "nuxt build",
    "serve": "node .output/server/index.mjs",
    "preview:cf": "wrangler dev --x-remote-bindings",
    "deploy": "wrangler deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.25",
    "@better-auth/stripe": "^1.7.25",
    "@nuxt/ui": "~4.10.0",
    "@nuxthub/core": "^0.10.12",
    "@nuxtjs/i18n": "^9.5.6",
    "@nuxtjs/seo": "^3.2.2",
    "@vueuse/core": "^13.9.0",
    "@vueuse/integrations": "^13.9.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.25",
    "date-fns": "^4.4.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "echarts": "^5.6.0",
    "ioredis": "^5.8.2",
    "nuxt": "~4.4.8",
    "nuxt-echarts": "^0.4.0",
    "ofetch": "^1.5.1",
    "pg": "^8.23.1",
    "resend": "^6.38.1",
    "sortablejs": "^1.15.7",
    "stripe": "^20.0.0",
    "unstorage": "^1.17.3",
    "uuid": "^13.0.0",
    "vue": "^3.5.45",
    "vue-component-type-helpers": "^3.3.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@iconify-json/lucide": "^1.2.156",
    "@iconify-json/simple-icons": "^1.2.103",
    "@nuxt/eslint": "~1.14.0",
    "@nuxt/test-utils": "^3.20.1",
    "@react-email/components": "^1.0.1",
    "@react-email/render": "^2.3.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.6.0",
    "auth": "1.7.25",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "playwright-core": "^1.65.1",
    "postgres": "^3.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.14",
    "wrangler": "~4.107.1"
  }
}
