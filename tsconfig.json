{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // scripts/*.ts run under plain Node type stripping, which needs the
    // `.ts` extension on relative imports.
    "allowImportingTsExtensions": true
  },
  "include": [
    ".nuxt/**/*.d.ts",
    "server/types/**/*.d.ts",
    "nuxt.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.vue"
  ]
}
